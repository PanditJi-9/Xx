<?xml version="1.0" encoding="utf-8"?>
<!--
  Only what this build can actually run is declared. The original manifest's 28 activities,
  11 services, 14 receivers and 13 providers stay in the original until their classes are
  ported: a component declared without its class is a crash at launch, and a manifest full of
  them would look more complete while doing less.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The wallpaper panel writes the original lobby wallpaper; the zen panel asks the user
         for notification-policy access before it can change the interruption filter. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- The original identity comes from the owner's own APK: the same launcher label and the same
         adaptive icon resources. §0.4 forbids copying a *reference* app's look, not reusing the
         owner's assets. Gradle installs cn.nubia.gamelauncher as requested; dev.redlab.gamespace
         is only the source namespace. A stock app signed with a different key cannot be updated. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_adaptive"
        android:label="@string/game_space_app_name"
        android:roundIcon="@mipmap/ic_launcher_round_adaptive"
        android:supportsRtl="true">

        <activity
            android:name="dev.redlab.gamespace.ProofActivity"
            android:exported="true" />

        <!-- The games are the app: the screen that lists them is the launcher entry. The status
             screen stays reachable for measurements but is no longer what a user lands on. -->
        <activity
            android:name="dev.redlab.gamespace.MainActivity"
            android:exported="false" />
        <activity
            android:name="dev.redlab.gamespace.GameListActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/GameSpaceTheme.Activity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The original Game Space Center shell and its own original theme. It keeps the stock
             action so it can be opened the same way the vendor build was. -->
        <activity
            android:name="dev.redlab.gamespace.GameCenterActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/gcs_gamecenter_title"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme_gcs_GameCenter.CenterActivityStyle">
            <intent-filter>
                <action android:name="cn.nubia.gamecenter.settings.action.GAME_CENTER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
