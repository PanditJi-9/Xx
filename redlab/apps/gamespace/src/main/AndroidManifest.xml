<?xml version="1.0" encoding="utf-8"?>
<!--
  Only what this build can actually run is declared. The original manifest's 28 activities,
  11 services, 14 receivers and 13 providers stay in the original until their classes are
  ported: a component declared without its class is a crash at launch, and a manifest full of
  them would look more complete while doing less.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The original identity comes from the owner's own APK: the same launcher label and the same
         adaptive icon resources. §0.4 forbids copying a *reference* app's look, not reusing the
         owner's assets; the package id stays dev.redlab.gamespace because cn.nubia.gamelauncher is
         already installed as a system app and cannot be replaced without root. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_adaptive"
        android:label="@string/game_space_app_name"
        android:roundIcon="@mipmap/ic_launcher_round_adaptive"
        android:supportsRtl="true">

        <activity
            android:name="dev.redlab.gamespace.ProofActivity"
            android:exported="true" />

        <activity
            android:name="dev.redlab.gamespace.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="dev.redlab.gamespace.GameListActivity"
            android:exported="false" />
    </application>
</manifest>
