    <string name="lobby_row_entrance">Kino ieeja</string>
    <string name="lobby_row_entrance_desc">Īss gaismas ātruma ievads ar skaņu katru reizi, kad tiek atvērts vestibils. Pieskarieties ekrānam, lai to izlaistu.</string>
