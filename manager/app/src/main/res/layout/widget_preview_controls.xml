<?xml version="1.0" encoding="utf-8"?>
<!-- معاينة ثابتة — ثلاث بلاطات: تحرير، جزيرة (مشغّلة = معبّأة بالتمييز)، تخزين. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="110dp"
    android:background="@drawable/widget_preview_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_weight="1"
        android:background="@drawable/widget_preview_tile"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/widget_action_boost"
            android:src="@drawable/widget_ic_boost"
            android:tint="@color/widget_preview_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/widget_action_boost"
            android:textColor="@color/widget_preview_text"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="6dp"
        android:layout_height="1dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_weight="1"
        android:background="@drawable/widget_preview_tile_accent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/widget_action_island"
            android:src="@drawable/widget_ic_island"
            android:tint="@color/widget_preview_bg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/widget_action_island"
            android:textColor="@color/widget_preview_bg"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="6dp"
        android:layout_height="1dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_weight="1"
        android:background="@drawable/widget_preview_tile"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/widget_action_open_storage"
            android:src="@drawable/widget_ic_storage"
            android:tint="@color/widget_preview_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/widget_action_open_storage"
            android:textColor="@color/widget_preview_text"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
