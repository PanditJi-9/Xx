<?xml version="1.0" encoding="utf-8"?>
<!-- معاينة ثابتة (previewLayout) — صورة الصميم: خلايا القياس الأربع كمّا تبدو. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="110dp"
    android:background="@drawable/widget_preview_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/widget_stat_battery"
            android:src="@drawable/widget_ic_battery"
            android:tint="@color/widget_preview_positive" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="82%"
            android:textColor="@color/widget_preview_positive"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_stat_battery"
            android:textColor="@color/widget_preview_dim"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/widget_stat_temp"
            android:src="@drawable/widget_ic_temp"
            android:tint="@color/widget_preview_caution" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="39°"
            android:textColor="@color/widget_preview_caution"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_stat_temp"
            android:textColor="@color/widget_preview_dim"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/widget_stat_cpu"
            android:src="@drawable/widget_ic_cpu"
            android:tint="@color/widget_preview_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24%"
            android:textColor="@color/widget_preview_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_stat_cpu"
            android:textColor="@color/widget_preview_dim"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/widget_stat_ram"
            android:src="@drawable/widget_ic_ram"
            android:tint="@color/widget_preview_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="62%"
            android:textColor="@color/widget_preview_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_stat_ram"
            android:textColor="@color/widget_preview_dim"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
