    <string name="ns_transport_other">इतर</string>
    <string name="ns_sources_title">हे कुठून येते</string>
    <string name="ns_sources_body">पत्ते आणि गेटवे प्लॅटफॉर्मच्या लिंक गुणधर्मांवरून वाचले जातात. शेजारी सारणी कर्नलच्या ARP कॅशेमधून वाचली जाते, त्यामुळे या उपकरणाने अलीकडे जे बोलले आहे तेच ते ठेवते — रिक्त टेबलचा अर्थ रिक्त नेटवर्क असा होत नाही.</string>
    <string name="ns_refresh">रिफ्रेश करा</string>
    <string name="ns_probe">सामान्य पोर्ट्सची तपासणी करा</string>
    <string name="ns_probe_stop">थांबा</string>
    <string name="ns_probe_progress">%2$d पैकी %1$d तपासत आहे</string>
    <string name="ns_probe_note">पोर्ट 22, 80, 443, 5000 आणि 5555 वर या/24 वर TCP कनेक्ट पाठवते. उत्तरे देणारे पोर्ट कळवले जाते; शांतता हा पुरावा नाही की होस्ट अनुपस्थित आहे.</string>
    <string name="ns_neighbours">ओळखीचे शेजारी</string>
    <string name="ns_neighbours_note">/proc/net/arp वरून — फक्त वाचा.</string>
    <string name="ns_neighbours_empty">शेजारी अजून ओळखले नाहीत.</string>
    <string name="ns_ports_value">पोर्ट्स %1$s</string>
