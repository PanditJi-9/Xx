    <string name="ns_dns">DNS</string>
    <string name="ns_mac">MAC</string>
    <string name="ns_transport_wifi">Wi-Fi</string>
    <string name="ns_transport_ethernet">Ethernet</string>
    <string name="ns_transport_cellular">Клетъчен</string>
