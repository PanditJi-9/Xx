    <string name="network_scanner_title">Скенер за локална мрежа</string>
    <string name="network_scanner_subtitle">Вашият адрес, шлюзът, до който достига, и кои съседи са отговорили.</string>
    <string name="max_role_network_scanner">Чете мрежата, в която се намирате — без улавяне, без root.</string>
    <string name="ns_no_network">Няма свързана мрежа.</string>
