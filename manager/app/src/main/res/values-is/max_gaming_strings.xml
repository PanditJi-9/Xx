    <string name="lobby_row_entrance">Kvikmyndalegur inngangur</string>
    <string name="lobby_row_entrance_desc">Stutt ljóshraða inngangur með hljóði í hvert sinn sem anddyrið opnar. Bankaðu á skjáinn til að sleppa því.</string>
    <string name="lobby_entrance_skip">Slepptu inngangi</string>
    <string name="lobby_head_shortcut">Flýtileið á heimaskjá</string>
    <string name="lobby_shortcut_desc">Bætir Game Space tákni við heimaskjáinn þinn. Með því að smella á það opnast þessi anddyri beint og byrjar með kvikmyndainnganginum.</string>
    <string name="lobby_shortcut_add">Bæta við heimaskjá</string>
    <string name="lobby_shortcut_requested">Staðfestu í ræsiforritinu þínu til að setja táknið. Ef ekkert birtist gæti ræsiforritið þitt verið að loka á flýtileiðir (á Xiaomi: Forritsupplýsingar → Aðrar heimildir → Flýtileiðir heimaskjás), eða notaðu aðskilið forritatáknið hér að neðan.</string>
    <string name="lobby_shortcut_exists">Kerfið tilkynnir þessa flýtileið sem þegar festa og táknið og nafn hennar voru endurnýjuð. Ef þú getur ekki séð það á heimaskjánum þínum skaltu fjarlægja það og bæta því við aftur, eða nota aðskilið forritatáknið hér að neðan.</string>
    <string name="lobby_shortcut_unsupported">Ræsirinn þinn styður ekki að bæta við flýtileiðum. Prófaðu annan ræsiforrit.</string>
    <string name="lobby_shortcut_failed">Ekki var hægt að búa til flýtileiðina.</string>
    <string name="lobby_shortcut_icon_title">Aðskilið forritatákn fyrir leikanddyri</string>
    <string name="lobby_shortcut_icon_detail">Bætir „leikjaanddyri“ við forritaskúffuna þína svo þú getir dregið það á heimaskjáinn eins og hvaða forrit sem er. Það virkar jafnvel þegar ræsiforritið þitt lokar á flýtileiðir.</string>
    <string name="lobby_shortcut_icon_on">Kveikt er á tákninu. Leitaðu að „leikjaanddyri“ í forritaskúffunni þinni (það getur tekið nokkrar sekúndur).</string>
    <string name="lobby_shortcut_icon_failed">Gat ekki breytt stöðu táknsins.</string>
