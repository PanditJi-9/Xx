<resources>
    <string name="copg_tags_title">COPG বিকল্পসমূহ</string>
    <string name="copg_tags_desc">উদ্দেশ্য হিচাপে সংৰক্ষণ কৰা হৈছে আৰু ডিভাইচ আলেখ্যনৰ সৈতে একেলগে লিখা হৈছে। কেৱল চাৰিটা আৰামৰ বিকল্পই প্ৰতিটো চিঅ’পিজি সংস্কৰণত কাম কৰে; বাকীবোৰৰ বাবে COPG 6.8.0 বা নতুনৰ প্ৰয়োজন। PRO বিকল্পসমূহৰ বাবে এটা COPG PRO অনুজ্ঞাপত্ৰৰ প্ৰয়োজন, আৰু ইঞ্জিনে সিহতক আওকাণ কৰিব পাৰে।</string>
    <string name="copg_tier_pro">PRO</string>
    <string name="copg_footprint_resident">এপ\'s মেম\'ৰীত থাকে, কেতিয়াও এন্টি-চিট গেমৰ সৈতে ব্যৱহাৰ নকৰিব</string>
