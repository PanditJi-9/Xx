    <string name="ns_sources_title">ഇത് എവിടെ നിന്ന് വരുന്നു</string>
    <string name="ns_sources_body">വിലാസങ്ങളും ഗേറ്റ്‌വേയും പ്ലാറ്റ്‌ഫോമിൻ്റെ ലിങ്ക് പ്രോപ്പർട്ടികളിൽ നിന്ന് വായിക്കുന്നു. കേർണലിൻ്റെ ARP കാഷെയിൽ നിന്നാണ് അയൽപക്ക പട്ടിക വായിക്കുന്നത്, അതിനാൽ ഈ ഉപകരണം അടുത്തിടെ സംസാരിച്ചത് മാത്രം ഉൾക്കൊള്ളുന്നു - ശൂന്യമായ ടേബിൾ അർത്ഥമാക്കുന്നത് ശൂന്യമായ നെറ്റ്‌വർക്ക് എന്നല്ല.</string>
    <string name="ns_refresh">പുതുക്കുക</string>
    <string name="ns_probe">സാധാരണ തുറമുഖങ്ങൾ പരിശോധിക്കുക</string>
    <string name="ns_probe_stop">നിർത്തുക</string>
    <string name="ns_probe_progress">%1$d ഓഫ് %2$d അന്വേഷിക്കുന്നു</string>
    <string name="ns_probe_note">ഈ /24-ൽ ഉടനീളമുള്ള 22, 80, 443, 5000, 5555 എന്നീ പോർട്ടുകളിൽ ഒരു TCP കണക്ഷൻ അയയ്ക്കുന്നു. ഉത്തരം നൽകുന്ന ഒരു പോർട്ട് റിപ്പോർട്ടുചെയ്‌തു; ആതിഥേയൻ ഇല്ലെന്നതിൻ്റെ തെളിവല്ല നിശബ്ദത.</string>
    <string name="ns_neighbours">അറിയപ്പെടുന്ന അയൽക്കാർ</string>
    <string name="ns_neighbours_note">/proc/net/arp-ൽ നിന്ന് - വായിക്കാൻ മാത്രം.</string>
    <string name="ns_neighbours_empty">അയൽവാസികളെ ഇതുവരെ അറിയില്ല.</string>
