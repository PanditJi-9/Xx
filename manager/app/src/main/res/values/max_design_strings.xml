<?xml version="1.0" encoding="utf-8"?>
<!--
    MaxManager Design Language vocabulary.

    Kept in a separate file from strings.xml so the shared UI vocabulary is
    reviewable on its own and cannot be lost in the 100k+ product string file.
    These strings describe how trustworthy a reading is; they are shown next to
    every telemetry value in the app.
-->
<resources>
    <!-- Data trust vocabulary -->
    <string name="max_trust_live">Live</string>
    <string name="max_trust_stale">Last sample</string>
    <string name="max_trust_snapshot">Snapshot</string>
    <!-- الدورة الأولى لم تكتمل: السؤال لم يُطرح بعد، وهو ليس «لا قراءة». -->
    <string name="max_trust_loading">Reading…</string>
    <string name="max_trust_unreadable">No reading</string>
    <string name="max_trust_unsupported">Not supported</string>

    <!-- Provenance line -->
    <string name="max_source_label">Source</string>
    <string name="max_updated_label">Updated</string>
    <string name="max_provenance_separator">" · "</string>

    <!-- Accessibility -->
    <string name="max_value_unavailable_a11y">no value available</string>
    <string name="max_expand_section">Show details</string>
    <string name="max_collapse_section">Hide details</string>

    <!--
        Governance vocabulary (UX re-engineering §5.4).
        Owner names are user-facing words, never enum names: the priority ladder is
        fixed by ControlOwnership and this file only says it in human language.
    -->
    <string name="max_gov_title">Who rules now</string>
    <string name="max_gov_separator">" › "</string>
    <string name="max_gov_order_note">Fixed order: a higher rung blocks a lower one. It never changes which policy wins.</string>
    <string name="max_gov_open_details">Active holders</string>
    <string name="max_gov_active_title">Who holds a control</string>
    <string name="max_gov_none">No policy owns a hardware control right now.</string>
    <string name="max_gov_count">Active control leases: %1$d</string>
    <string name="max_gov_requested">Requested: %1$s</string>
    <string name="max_gov_owner_recovery">Recovery</string>
    <string name="max_gov_owner_safety">Thermal safety</string>
    <string name="max_gov_owner_per_app">App profile</string>
    <string name="max_gov_owner_max_ai">MAX AI</string>
    <string name="max_gov_owner_global">Global profile</string>
    <string name="max_gov_owner_system">System</string>
    <string name="max_gov_owner_a11y">%1$s owns a hardware control</string>
    <string name="max_gov_now_none">No automated owner right now — control stays yours</string>
    <string name="max_gov_now_one">%1$s holds a control</string>
    <string name="max_gov_now_many">%1$s holds %2$d controls</string>
</resources>
