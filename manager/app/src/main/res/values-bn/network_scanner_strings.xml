    <string name="ns_sources_body">ঠিকানা এবং গেটওয়ে প্ল্যাটফর্মের লিঙ্ক বৈশিষ্ট্য থেকে পড়া হয়. প্রতিবেশী টেবিলটি কার্নেলের এআরপি ক্যাশে থেকে পড়া হয়, তাই এটি কেবলমাত্র এই ডিভাইসটির সাথে কথা বলেছে — একটি খালি টেবিল মানে খালি নেটওয়ার্ক নয়৷</string>
    <string name="ns_refresh">রিফ্রেশ</string>
