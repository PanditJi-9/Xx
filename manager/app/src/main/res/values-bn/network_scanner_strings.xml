    <string name="ns_probe_progress">%2$d এর মধ্যে %1$d অনুসন্ধান করা হচ্ছে</string>
    <string name="ns_probe_note">এই /24 জুড়ে 22, 80, 443, 5000 এবং 5555 পোর্টে একটি TCP সংযোগ পাঠায়। একটি পোর্ট যা উত্তর দেয় রিপোর্ট করা হয়; নীরবতা প্রমাণ নয় যে একজন হোস্ট অনুপস্থিত।</string>
