    <string name="ns_probe_stop">СТІЙ</string>
    <string name="ns_probe_progress">Зондування %1$d з %2$d</string>
    <string name="ns_probe_note">Надсилає TCP-з’єднання на порти 22, 80, 443, 5000 і 5555 через цей /24. Повідомляється порт, який відповідає; мовчання не є доказом відсутності хоста.</string>
    <string name="ns_neighbours">Знайомі сусіди</string>
    <string name="ns_neighbours_note">З /proc/net/arp — лише читання.</string>
    <string name="ns_neighbours_empty">Сусідів поки невідомо.</string>
    <string name="ns_ports_value">Порти %1$s</string>
