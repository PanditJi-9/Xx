<resources>
    <string name="copg_tags_title">COPG விருப்பங்கள்</string>
    <string name="copg_tags_desc">உள்நோக்கமாகச் சேமிக்கப்பட்டு சாதன சுயவிவரத்துடன் எழுதப்பட்டது. ஒவ்வொரு COPG பதிப்பிலும் நான்கு ஆறுதல் விருப்பங்கள் மட்டுமே வேலை செய்கின்றன; மீதமுள்ளவர்களுக்கு COPG 6.8.0 அல்லது புதியது தேவை. PRO விருப்பங்களுக்கு COPG PRO உரிமம் தேவை, மேலும் இயந்திரம் அவற்றைப் புறக்கணிக்கலாம்.</string>
    <string name="copg_tier_pro">PRO</string>
    <string name="copg_footprint_resident">ஆப்ஸின் நினைவகத்தில் இருக்கும், ஏமாற்று-எதிர்ப்பு விளையாட்டுகளுடன் பயன்படுத்த வேண்டாம்</string>
    <string name="copg_need_ack">கீழே உள்ள அபாயத்தை முதலில் அங்கீகரிக்கவும்</string>
    <string name="copg_tag_refused">நிறுவப்பட்ட COPG பதிப்பிற்கு தேர்ந்தெடுக்கப்பட்ட COPG விருப்பம் அனுமதிக்கப்படாது. எதுவும் எழுதப்படவில்லை.</string>
    <string name="copg_tag_needs_device">விருப்பங்கள் சாதன சுயவிவரத்துடன் எழுதப்பட்டுள்ளன, மேலும் இந்த பயன்பாட்டில் இதுவரை எதுவும் இல்லை.</string>
