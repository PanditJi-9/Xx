<resources>
    <!-- شارة الرأس في الرئيسية: بديل «Idle» (أمر المالك ٢٠٢٦-١١-١٦). -->
    <string name="home_not_active">غير مفعّل</string>
    <string name="home_status_reason_title">لماذا غير مفعّل؟</string>
    <string name="home_status_reason_body">مسار واحد يعمل يكفي ليكون «مفعّلًا»: الجذر مع تثبيت الوحدة، أو Shizuku بإذنه ممنوحًا.</string>
    <!-- الحالة المفعّلة لا تفتح نافذة «لماذا غير مفعّل؟» (أمر المالك ٢٠٢٦-١١-٢٠) -->
    <string name="home_status_active_title">كل شيء يعمل</string>
    <string name="home_status_active_body">المسار الذي اخترته يعمل، ولهذا التطبيق مفعّل. السطور التالية تعرض كل قطعة كما هي الآن: الجذر وShizuku طريقان إلى الغاية نفسها، فالطريق الذي لم تسلكه غير مطلوب. والقطعة الناقصة تضيّق ما يستطيعه التطبيق، ولا تعني أنه متوقّف.</string>
    <string name="home_status_row_root">الجذر ممنوح</string>
    <string name="home_status_row_module">الوحدة مثبّتة</string>
    <string name="home_status_row_shizuku">Shizuku جاهز</string>
    <!-- سطر الخادم الخلفيّ: «يعمل» و«يرفض هويّة التطبيق» و«لا يجيب» ثلاث حالات لا واحدة -->
    <string name="home_status_row_daemon_running">الخادم يعمل ويردّ</string>
    <string name="home_status_row_daemon_denied">الخادم يعمل لكنه يرفض هويّة هذا التطبيق</string>
    <string name="home_status_row_daemon_unreachable">الخادم لا يجيب؛ والتطبيق يعمل عبر مساره المباشر</string>
    <string name="home_status_row_daemon_stopped">الخادم يردّ لكنه لا يعلن نفسه عاملًا</string>
    <!-- سببٌ مقيس: تحديث وحدة معلّق يوقف الخادم حتى الإقلاع (قياس جهاز المالك ٢٠٢٦-١١-٢٠) -->
    <string name="home_status_row_daemon_update_pending">تحديث الوحدة معلّق، ولذلك يبقى الخادم متوقفًا حتى تعيد التشغيل. أعِد التشغيل ليعمل؛ وإلى ذلك الحين يعمل التطبيق عبر مساره المباشر.</string>
    <string name="home_status_close">إغلاق</string>
    <!-- تفعيل الوحدة بلا إنترنت من حِمل مضمَّن (أمر المالك ٢٠٢٦-١١-١٦) -->
    <string name="home_status_enable_module">تفعيل الوحدة (بلا إنترنت)</string>
    <string name="home_status_enable_module_running">جارٍ كتابة الوحدة…</string>
    <string name="home_status_enable_module_written">كُتبت الوحدة — أعِد التشغيل لتعمل</string>
    <string name="home_status_enable_module_failed">تعذّر كتابة الوحدة: %1$s</string>
