    <string name="ns_sources_title">ይህ ከየት የመጣ ነው።</string>
    <string name="ns_sources_body">አድራሻዎች እና መግቢያ በር የሚነበቡት ከመድረክ ማገናኛ ባህሪያት ነው። የጎረቤት ሠንጠረዥ የሚነበበው ከከርነል ARP መሸጎጫ ነው፣ ስለዚህ ይህ መሳሪያ በቅርቡ የተነጋገረውን ብቻ ይይዛል - ባዶ ጠረጴዛ ማለት ባዶ አውታረ መረብ ማለት አይደለም።</string>
    <string name="ns_refresh">አድስ</string>
    <string name="ns_probe">የጋራ ወደቦችን ይመርምሩ</string>
    <string name="ns_probe_stop">ተወ</string>
    <string name="ns_probe_progress">ምርመራ %1$d የ%2$d</string>
    <string name="ns_probe_note">በዚህ/24 ላይ የTCP ግንኙነትን ወደቦች 22፣ 80፣ 443፣ 5000 እና 5555 ይልካል። መልስ የሚሰጥ ወደብ ሪፖርት ተደርጓል; አስተናጋጅ አለመኖሩን ዝምታ አያረጋግጥም።</string>
    <string name="ns_neighbours">የታወቁ ጎረቤቶች</string>
    <string name="ns_neighbours_note">ከ/proc/net/arp - ማንበብ ብቻ።</string>
    <string name="ns_neighbours_empty">እስካሁን ምንም ጎረቤቶች አይታወቁም።</string>
