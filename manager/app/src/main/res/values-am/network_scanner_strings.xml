<resources>
    <string name="network_scanner_title">የአካባቢ አውታረ መረብ ስካነር</string>
    <string name="network_scanner_subtitle">አድራሻዎ፣ የሚደርስበት መግቢያ እና የትኛው ጎረቤቶች መልስ ሰጥተዋል።</string>
    <string name="max_role_network_scanner">ያሉበትን አውታረ መረብ ያነባል - ምንም አይያዝም፣ ስር የለም።</string>
    <string name="ns_no_network">ምንም አውታረ መረብ አልተገናኘም።</string>
