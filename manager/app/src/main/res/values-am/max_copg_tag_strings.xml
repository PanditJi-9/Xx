<resources>
    <string name="copg_tags_title">የ COPG አማራጮች</string>
    <string name="copg_tags_desc">እንደ ሐሳብ ተቀምጧል እና ከመሳሪያው መገለጫ ጋር አንድ ላይ ተጽፏል። በእያንዳንዱ የ COPG ስሪት ላይ አራት ምቾት አማራጮች ብቻ ይሰራሉ; የተቀሩት COPG 6.8.0 ወይም ከዚያ በላይ ያስፈልጋቸዋል. PRO አማራጮች የ COPG PRO ፍቃድ ያስፈልጋቸዋል፣ እና ሞተሩ ችላ ሊላቸው ይችላል።</string>
    <string name="copg_tier_pro">ፕሮ</string>
    <string name="copg_footprint_resident">በመተግበሪያው ማህደረ ትውስታ ውስጥ ይቆያል ፣ በፀረ-ማጭበርበር ጨዋታዎች በጭራሽ አይጠቀሙ</string>
    <string name="copg_need_ack">በመጀመሪያ ከዚህ በታች ያለውን አደጋ እውቅና ይስጡ</string>
    <string name="copg_tag_refused">ለተጫነው የ COPG ስሪት የተመረጠ የ COPG አማራጭ አይፈቀድም። ምንም አልተጻፈም።</string>
    <string name="copg_tag_needs_device">አማራጮች የተፃፉት በመሳሪያ መገለጫ ነው፣ እና ይህ መተግበሪያ እስካሁን ምንም የለውም።</string>
