# SELinux policy for MaxManager daemon
# =====================================

type maxmanager, domain;
# **و`vendor_file_type` كانت متناقضة مع بقيّة الملفّات الثلاثة** (تكملة ١٣٩): الملفّات
# الثلاثة الأخرى كلّها تُثبّت مسارًا **واحدًا** في `/system/bin` — الوحدة في `Android.bp`
# (تعليقها: «القسم `system` وحده (بلا `vendor`/`product_specific` معًا)»)، وسطر
# `service` في `maxmanager.rc`، والوسم في `file_contexts`. فوصفُ نوع التنفيذ بأنه
# `vendor_file_type` يجعل بناء الـsepolicy يرفض الجمع (`/system/bin` تحت `system_file`
# ووسم قسم آخر في الوقت نفسه). أُزيل الوصف الواحد المخالف، وبقيت `exec_type, file_type`
# وهي ما تحمله ثنائيات `/system/bin` فعلًا. **و`neverallow` في الشجرة الحقيقية لم يُشَغّل
# هنا** (لا شجرة AOSP في هذه البيئة) — فالحكم النهائيّ يحتاج بناء sepolicy.
type maxmanager_exec, exec_type, file_type;
type maxmanager_tmpfs, file_type;
type maxmanager_data_file, file_type, data_file_type;

init_daemon_domain(maxmanager)

# Allow the daemon to communicate with the system
allow maxmanager self:capability { sys_admin net_admin sys_resource };
allow maxmanager self:process { setrlimit };

# Access to sysfs and proc
allow maxmanager sysfs:file { read write open getattr };
allow maxmanager proc:file { read write open getattr };
allow maxmanager proc_net:file { read };

# Access to thermal and battery devices
allow maxmanager thermal_device:chr_file { read write open ioctl };
allow maxmanager battery_device:chr_file { read write open ioctl };
allow maxmanager gpu_device:chr_file { read write open ioctl };

# Access to system properties
allow maxmanager property_socket:sock_file { write };
allow maxmanager system_prop:property_service { set };
allow maxmanager shell_prop:property_service { set };

# Allow execution of shell commands (if needed)
allow maxmanager shell_exec:file { read execute open getattr };
allow maxmanager toolbox_exec:file { read execute open getattr };

# Allow logging
allow maxmanager logd:unix_dgram_socket { sendto };
allow maxmanager logd:fd { use };

# Allow access to /data partition for storing state
allow maxmanager maxmanager_data_file:dir { create read write search open getattr };
allow maxmanager maxmanager_data_file:file { create read write open getattr unlink };

# Allow binder communication with the app
allow maxmanager appdomain:binder { call transfer };
allow maxmanager system_app:binder { call transfer };
allow maxmanager platform_app:binder { call transfer };

# Allow reading from rootfs for device info
allow maxmanager rootfs:file { read open getattr };

# Allow access to /dev/urandom for entropy
allow maxmanager urandom_device:chr_file { read open };

# This file must be added to BOARD_SEPOLICY_DIRS in BoardConfig.mk

# ── قناة التطبيق ↔ الخادم (archdaemon/jni/src/Ipc/IpcServer.c) ───────────────────────────────
# سوكيت unix مجرّد `@maxmanager.sock`: الخادم ينشئه ويقبل عليه، ويقرأ uid التطبيق من packages.list
# ليتحقّق منه بنفسه (SO_PEERCRED)، ويشغّل ثنائيّه بـ`--profile N` فيحتاج `execute_no_trans` على نفسه.
# ملاحظة: هذه القواعد كُتبت بلا روم حقيقي للاختبار؛ ما يغيب منها يُولَّد من سجلّ جهازك بـ`make_sepolicy.py`.
allow maxmanager self:unix_stream_socket create_stream_socket_perms;
allow maxmanager priv_app:unix_stream_socket { getattr getopt read write shutdown };
allow maxmanager packages_list_file:file r_file_perms;
allow maxmanager maxmanager_exec:file { read open getattr map execute_no_trans };
allow maxmanager proc:lnk_file { read getattr };
# `ro.maxmanager.sepolicy` (علم الوضع المستقلّ) خاصية `ro.*` بلا تسمية خاصة فتقع في default_prop.
get_prop(maxmanager, default_prop)

# ── قراءة العقد وكتابة الخصائص لحساب التطبيق (المرحلة الثانية: READ / EXISTS / SETPROP) ───────────
# التطبيق بلا جذر يطلب عبر القناة، والخادم وحده يفتح العقدة بنطاقه. القراءة تشمل كل أنواع sysfs
# (الأسماء الدقيقة تختلف بين الرومات: sysfs_batteryinfo، sysfs_devfreq، sysfs_kgsl… — لذلك النوع الجامع).
allow maxmanager sysfs_type:file r_file_perms;
allow maxmanager sysfs_type:dir r_dir_perms;
# `persist.sys.maxmanagerconf.*` تقع في system_prop (ذُكرت قاعدة الكتابة أعلاه). وقراءتها لحساب التطبيق
# قائمة أصلًا لنطاق priv_app؛ فلا تسمية خاصة ولا قاعدة إضافية للتطبيق.

# ── كتابة العقد لحساب التطبيق (المرحلة الثالثة: WRITE) ───────────────────────────────────────────
# `setattr` لرقصة chmod (عقد HyperOS 3 تأتي 0444). و`sysctl_type` هو النوع الجامع لعقد /proc/sys/*
# (vm، kernel، net…). وقائمة المسارات المسموحة في IpcServer.c أضيق بكثير من هذه الأنواع.
allow maxmanager sysfs_type:file { write setattr };
allow maxmanager sysctl_type:file rw_file_perms;

# ── مراقب المقدّمة الأصليّ (archdaemon/jni/src/Standalone/ForegroundObserver.c) ─────────────────────
# يقرأ مجموعة top-app في cgroup (v1 أو v2) ثم `/proc/<pid>/cmdline` لعمليّات التطبيقات، ويكتب `app_status`
# في مجلّد الإعداد (adb_data_file) بكتابة مؤقّتة + rename. وعقد البطارية والإضاءة تغطّيها sysfs_type أعلاه.
allow maxmanager cgroup:dir r_dir_perms;
allow maxmanager cgroup:file r_file_perms;
allow maxmanager cgroup_v2:dir r_dir_perms;
allow maxmanager cgroup_v2:file r_file_perms;
allow maxmanager appdomain:dir { search getattr };
allow maxmanager appdomain:file { read open getattr };
allow maxmanager adb_data_file:dir create_dir_perms;
allow maxmanager adb_data_file:file create_file_perms;

